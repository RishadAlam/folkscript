APP_NAME=Folkscript
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Keep false: initialize permissions without demo users or stories.
SEED_DEMO_CONTENT=false
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Replace with the database and user created in cPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_folkscript
DB_USERNAME=cpaneluser_folkscript
DB_PASSWORD=

# These defaults do not require a Redis server.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
MEDIA_DISK=public
SCOUT_DRIVER=collection
SCOUT_QUEUE=true

# Configure real SMTP delivery before opening registration.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional services remain off until deliberately configured.
BROADCAST_CONNECTION=log
BROADCAST_NOTIFICATIONS=false
MAIL_NOTIFICATIONS=false
DIGESTS_ENABLED=false
ANALYTICS_ENABLED=false
SEO_RENDER_OG=false
