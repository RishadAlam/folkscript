APP_NAME=Folkscript
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development MySQL. Use a dedicated database account in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=folkscript
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
DISCOVERY_CACHE_SECONDS=60
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@folkscript.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public production installs should use HTTPS and secure cookies.
SESSION_SECURE_COOKIE=false

# Search uses database fallback until a private Meilisearch server is configured.
SCOUT_DRIVER=collection
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# OAuth callback URLs must match the provider application's allowlist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Payment keys/prices are placeholders. Keep live billing disabled until configured.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
CASHIER_CURRENCY=usd
MEMBERSHIP_MONTHLY_PRICE=8
MEMBERSHIP_YEARLY_PRICE=80

# Email preferences still apply when these delivery features are enabled.
DIGESTS_ENABLED=false
MAIL_NOTIFICATIONS=false
BROADCAST_NOTIFICATIONS=false

# Use BROADCAST_CONNECTION=reverb and run php artisan reverb:start to enable WebSockets.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Horizon requires Redis. Access is restricted to verified active administrators.
HORIZON_PATH=horizon

# Optional privacy-conscious analytics. Copy the script URL from your Plausible setup.
ANALYTICS_ENABLED=false
PLAUSIBLE_SCRIPT_URL=
PLAUSIBLE_DOMAIN=
PLAUSIBLE_ENDPOINT=https://plausible.io/api/event

# SEO integrations only send requests after the operator provides keys.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
SEO_RENDER_OG=false
SEO_BLOCK_TRAINING_BOTS=false
CHROME_PATH=
NODE_PATH_BINARY=
CHROME_NO_SANDBOX=false

# The demo seeder skips editorial accounts/content in production unless explicitly enabled.
SEED_DEMO_CONTENT=false

STRIPE_PAYOUTS_ENABLED=false
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.0
